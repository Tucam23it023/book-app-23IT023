<p>Số lần bạn truy cập (lưu trong session trên Atlas): <b>{{visits}}</b></p>

<table>
  <tr>
    <th>Mã</th><th>Tên sách</th><th>Tác giả</th>
    <th>Giá gốc</th><th>VAT</th><th>Giá sau thuế</th>
  </tr>
  {{#each books}}
  <tr>
    <td>{{code}}</td>
    <td>{{title}}</td>
    <td>{{author}}</td>
    <td>{{money price}}</td>
    <td>{{vat}}%</td>
    <td>{{money priceAfterTax}}</td>
  </tr>
  {{else}}
  <tr><td colspan="6">Chưa có sách nào.</td></tr>
  {{/each}}
</table>