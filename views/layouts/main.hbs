<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Quản lý Sách</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 900px; margin: 30px auto; padding: 0 15px; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
    th { background: #f0f0f0; }
    input { padding: 6px; width: 300px; }
    button { padding: 8px 16px; cursor: pointer; }
    .error { color: #c00; font-weight: bold; margin: 10px 0; }
    footer { margin-top: 40px; padding-top: 10px; border-top: 1px solid #ccc; color: #555; text-align: center; }
  </style>
</head>
<body>
  <h1>📚 Quản lý Sách</h1>
  <nav><a href="/">Danh sách</a> | <a href="/add">Thêm sách</a></nav>
  <hr>

  {{{body}}}

  <footer>
    Sinh viên: <b>{{studentName}}</b> | MSSV: <b>{{studentId}}</b> | VAT áp dụng: <b>{{vat}}%</b>
  </footer>
</body>
</html>